{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "athens-street-racers",
  "main": "worker/index.mjs",
  "account_id": "d6f3d2dc5817687a91d74ccd257bad9e",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node tools/prepare-deploy.mjs" },
  "assets": {
    "directory": ".deploy/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*", "/health", "/", "/index.html", "/robots.txt", "/sitemap.xml"]
  },
  "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "GameArena" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameArena"] }],
  "env": {
    "staging": {
      "name": "athens-street-racers-staging",
      "build": { "command": "ASR_BUILD_ENV=staging node tools/prepare-deploy.mjs" },
      "routes": [{ "pattern": "staging.athensracing.com", "custom_domain": true }],
      "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "GameArena" }] }
    },
    "production": {
      "name": "athens-street-racers",
      "build": { "command": "ASR_BUILD_ENV=production node tools/prepare-deploy.mjs" },
      "routes": [
        { "pattern": "athensracing.com", "custom_domain": true },
        { "pattern": "www.athensracing.com", "custom_domain": true }
      ],
      "durable_objects": { "bindings": [{ "name": "GAME", "class_name": "GameArena" }] }
    }
  }
}
