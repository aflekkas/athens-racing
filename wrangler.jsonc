{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "athens-street-racers",
  "main": "worker/index.mjs",
  "account_id": "d6f3d2dc5817687a91d74ccd257bad9e",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "node tools/prepare-deploy.mjs"
  },
  "assets": {
    "directory": ".deploy/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameArena"
      },
      {
        "name": "PRESENCE",
        "class_name": "FriendsPresence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameArena"
      ]
    },
    {
      "tag": "v2-accounts",
      "new_sqlite_classes": [
        "FriendsPresence"
      ]
    },
    {
      "tag": "v3-phone-wheel",
      "new_sqlite_classes": [
        "PhoneWheelRoom"
      ]
    },
    {
      "tag": "v4-remove-phone-wheel",
      "deleted_classes": [
        "PhoneWheelRoom"
      ]
    }
  ],
  "env": {
    "staging": {
      "name": "athens-street-racers-staging",
      "vars": {
        "ASR_UNIFIED_ROUTES": "syntagma-pilot,psychiko-faros,riviera-coast,penteli-hill,penteli-descent,megara-club",
        "ATHENS_WORLD_MANIFEST": "manifests/5b7c87c65d6ce353fc3e7ede46d54e91aa79c5303407c58d1d42cca9c921190d.json"
      },
      "build": {
        "command": "ASR_BUILD_ENV=staging ASR_UNIFIED_ROUTES=syntagma-pilot,psychiko-faros,riviera-coast,penteli-hill,penteli-descent,megara-club node tools/prepare-deploy.mjs"
      },
      "routes": [
        {
          "pattern": "staging.athensracing.com",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME",
            "class_name": "GameArena"
          },
          {
            "name": "PRESENCE",
            "class_name": "FriendsPresence"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "ACCOUNTS",
          "database_name": "athens-racing-accounts-staging",
          "database_id": "5e3d1170-f253-4de6-bff4-8b8f2c0027f4",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": [
          "17 3 * * *"
        ]
      },
      "r2_buckets": [
        {
          "binding": "ATHENS_WORLD",
          "bucket_name": "athens-racing-world-staging"
        }
      ]
    },
    "production": {
      "name": "athens-street-racers",
      "build": {
        "command": "ASR_BUILD_ENV=production node tools/prepare-deploy.mjs"
      },
      "routes": [
        {
          "pattern": "athensracing.com",
          "custom_domain": true
        },
        {
          "pattern": "www.athensracing.com",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME",
            "class_name": "GameArena"
          },
          {
            "name": "PRESENCE",
            "class_name": "FriendsPresence"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "ACCOUNTS",
          "database_name": "athens-racing-accounts",
          "database_id": "965f63b7-a248-415e-ba11-f5f4c15d8c79",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": {
        "crons": [
          "17 3 * * *"
        ]
      },
      "r2_buckets": [
        {
          "binding": "ATHENS_WORLD",
          "bucket_name": "athens-racing-world"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "ACCOUNTS",
      "database_name": "athens-racing-accounts-staging",
      "database_id": "5e3d1170-f253-4de6-bff4-8b8f2c0027f4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATHENS_WORLD",
      "bucket_name": "athens-racing-world-staging"
    }
  ]
}
