+// Cache a requested compressed tile slice, rather than fetching its whole region.
+// Cache Storage rejects 206 responses; the internal entry is 200 and replay is 206.
+// Its immutable bundle hash + exact byte interval prevent release/range collisions.
+async function fromTileRange(request, path) {
+  const match = /^bytes=(\d+)-(\d+)$/.exec(request.headers.get('range') || '');
+  if (!match) return fetch(request);
+  const start=Number(match[1]), end=Number(match[2]), length=end-start+1;
+  if (!Number.isSafeInteger(start) || !Number.isSafeInteger(end) || start<0 || length<1 || length>25*1024*1024) return fetch(request);
